#预编译
__pycache__/

#杂项
*.py[cod]
*.egg-info/

#输出
build/
dist/

# 打包产物（release/<名字>-<日期>/ 这种）
release/

#环境
.venv/
venv/

#缓存
.pytest_cache/
.ruff_cache/

#日志（仅忽略仓库根的运行日志，勿误伤 frontend 下的 logs 页面目录）
/logs/
#示例跑出来的日志片（examples/*.py 都往自己目录下的 logs 落一份，跑一遍就冒出来）
/examples/logs/

#运行期数据（默认头像目录 [api] avatar_dir = data/avatars 落这儿）
/data/

#配置（本地生效的 config.toml 不入库，只入库模板 config.toml.example）
/config.toml

#前端
frontend/node_modules/
frontend/dist/
frontend/.vite/
# tsc 增量构建缓存（npx tsc -b 的产物）
frontend/*.tsbuildinfo
# Vite 本地环境覆盖（含本机后端地址等，只在各自机器上生效）
frontend/.env.*.local

.trae

# playwright-cli 的工作目录（截图 / 快照 / 控制台日志这类诊断产物）
.playwright-cli/
