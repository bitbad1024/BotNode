# =============================================================================
# BotNode 应用配置模板
# =============================================================================
# 用法：复制成 config.toml 再按自己环境改（config.toml 已写进 .gitignore，不入库；
# 这个文件才是入库的模板，改它也改不了实际生效的配置）。
#     Windows:  copy config.toml.example config.toml
#     Linux:    cp   config.toml.example config.toml
#
# 怎么读这个文件：
#   1. 全文件按「区域」划分，一个区域 = 一节 = 一类设置，用横线隔开，跳着看即可：
#        [app]               进程名、调试开关
#        [database]          整项目共用的数据库连接（sqlite / mariadb）
#        [logging]           日志总控：级别、控制台
#        [logging.file]      日志落本地文件
#        [logging.database]  日志落数据库（连接项默认继承 [database]）
#        [logging.queue]     日志异步队列与分发器
#        [cache]             缓存总控：用哪个后端（默认本地内存）
#        [cache.redis]       Redis 连接（backend = "redis" 时才看）
#        [api]               接口层：监听地址、路由前缀、令牌有效期
#        [onebot]            OneBot 反向 WS 接入：监听地址、路径
#        [kook]              Kook 正向 WS 接入：连法调优 + 凭证加密密钥
#   2. 每项都在上一行写了自己管什么，值就是代码里的默认值 —— 不改就等于没写。
#   3. 整个文件不写、某一节不写、某一项不写都能跑，缺的按默认值补；
#      只有值写错（级别名拼错、该填整数填了字符串等）才会启动失败。
#   4. 顶层允许有别的节（留给 api / db 等层），不会被检查。
#
# 数据库配置按「专用 > 公共 > 默认」逐项覆盖：[logging.database] 的专用项 >
# [database] 公共项 > 代码里的字段默认值。
# =============================================================================


# =============================================================================
# 区域 1/11：[app] —— 进程自己
# =============================================================================
[app]
# 进程名，同时作为日志核心名（子实例都以它为前缀，如 botnode.app）
name = "botnode"
# 调试模式：置 true 时忽略 [logging] 的 level，直接把级别开到 DEBUG
debug = false


# =============================================================================
# 区域 2/11：[database] —— 数据库公共连接
# 整个项目共用的一份连接（日志出口、以后的数据层都默认用它）
# =============================================================================
[database]
# 用哪个后端：sqlite（本地单文件）/ mariadb（MariaDB / MySQL 服务）
driver = "sqlite"

# ---- 只有 driver = "sqlite" 时才看这几项 ----
# 数据库文件路径；相对路径相对项目根目录（数据文件与头像同在 data/ 下）
path = "data/botnode.db"

# ---- 只有 driver = "mariadb" 时才看这几项 ----
# 服务地址与端口
host = "127.0.0.1"
port = 3306
# 登录用户 / 密码（config.toml 不入库，密码写在这里不会进 git）
user = "botnode"
password = ""
# 库名（要事先建好：CREATE DATABASE botnode CHARACTER SET utf8mb4;）
database = "botnode"


# =============================================================================
# 区域 3/11：[logging] —— 日志总控
# =============================================================================
[logging]
# 最低输出级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
level = "INFO"
# 是否往控制台输出（服务端 / 无人值守时置 false）
console = true
# 控制台是否按级别上 ANSI 颜色
console_color = true
# 控制台单独的级别；留空 "" 表示跟随上面的 level（控制台通常只给人看，可以比文件粗）
console_level = ""


# =============================================================================
# 区域 4/11：[logging.file] —— 日志落本地文件
# =============================================================================
[logging.file]
# 是否落本地文件；false 就只有控制台
enabled = true
# 放日志片的目录；相对路径相对项目根目录（app.py 所在目录）
dir = "logs"
# 片名前缀；留空 = 用 [app].name，于是片名与进程名一致（botnode-2026-09-28.log）
prefix = ""
# 一片最多写多久（分钟）；0 = 只按天分片。片名 = <前缀>-<日期>[.<序号>].log
rotate_minutes = 60
# 单片大小兜底（字节）：到了也换片（下面这个是 20MB）；0 = 不限
max_bytes = 20971520
# 保留几天（按片名里的日期算）；0 = 不清理
keep_days = 14
# 检索「本机文件」时默认往回找几天（页面上没给时间范围时兜底）；0 = 不限
search_days = 2
# 攒够多少条写一次盘（1 = 每条直写，最慢但最稳）
buffer_size = 200
# 最多攒多久（秒）必须写一次盘
flush_interval = 2.0


# =============================================================================
# 区域 5/11：[logging.database] —— 日志再落一份到数据库
# =============================================================================
[logging.database]
# 是否把日志再落一份到数据库（多一路出口，和文件出口并存）
enabled = false

# 日志出口特有的项（连接项默认整项继承上面的 [database]，只写日志特有的）
# 攒够多少条写一次库
buffer_size = 500
# 最多攒多久（秒）必须写一次库
flush_interval = 5.0

# 落库走异步驱动（sqlite 用 aiosqlite、mariadb 用 aiomysql），与业务存储共用同一个引擎；
# 日志表固定叫 logs——和 users / auth_sessions 一样由代码声明，这里没有表名可配。
#
# 要给日志单独连另一个库，就在这一节里按需覆盖，覆盖是逐项的（没写的继续继承）：
# driver = "mariadb"
# path = "logs/botnode-log.db"      # sqlite 用
# host = "10.0.0.5"               # mariadb 用
# port = 3306
# user = "botnode_log"
# password = ""
# database = "botnode_log"


# =============================================================================
# 区域 6/11：[logging.queue] —— 日志异步队列与分发器
# =============================================================================
[logging.queue]
# 队列容量，满了按「丢弃最旧」处理
maxsize = 10000
# 分发器一轮最多取多少条
dispatch_batch_size = 200
# 分发器一轮最多等多久（秒）
dispatch_timeout = 0.2


# =============================================================================
# 区域 7/11：[cache] —— 缓存总控
# 这一节不写也能用：默认走进程内存（本地缓存），不启用 Redis 也不用装它
# =============================================================================
[cache]
# 用哪个后端：memory（进程内存，默认）/ redis（Redis 服务，需 pip install "botnode[redis]"）
backend = "memory"
# Redis 上的键前缀；多个应用共用一个 Redis 实例时用它隔离（memory 后端不看这项）
namespace = "botnode"
# set() 没给 ttl 时用几秒过期；0 表示永不过期
default_ttl = 0.0
# Redis 连不上时是否退回本地缓存：默认 false = 启动阶段就报错（并提示检查 [cache.redis] 配置），
# true = 记一条 warning 继续跑（想静默降级才打开它）
fallback_to_memory = false
# 本地缓存清扫过期键的间隔（秒）
sweep_interval = 30.0


# =============================================================================
# 区域 8/11：[cache.redis] —— Redis 连接
# 只有 backend = "redis" 时才看这一节
# =============================================================================
[cache.redis]
# 服务地址与端口
host = "127.0.0.1"
port = 6379
# 库号：不同库之间数据互相隔离（0-15）
db = 0
# Redis 6+ 的 ACL 用户名；留空 "" 表示默认用户
username = ""
# 密码（config.toml 不入库，密码写在这里不会进 git）；留空 "" 表示不认证
password = ""
# 单条命令的超时（秒）：连不上 / 卡住时按这个时间报错（或触发上面的降级）
socket_timeout = 5.0
# TCP 建连超时（秒）：不设的话走系统默认，连不上时实测要干等二十几秒
socket_connect_timeout = 5.0
# 建连失败后的重试次数（0 = 不重试）：驱动默认 10 次指数退避，连不上时白等很久；
# 这里默认只补一次，Redis 起不来时能尽快报错
connect_retries = 1
# 连接池上限
max_connections = 10


# =============================================================================
# 区域 9/11：[api] —— 接口层（登录等对外接口）
# =============================================================================
[api]
# HTTP 服务监听地址与端口（接口层随主程序由 uvicorn 起）。
# 默认 0.0.0.0 = 所有网卡都收，容器 / 局域网里别的机器才连得进来；
# 只在本机用、不想对外暴露就改回 "127.0.0.1"
host = "0.0.0.0"
port = 18080
# 路由前缀：登录接口最终挂在 <prefix>/auth/login
prefix = "/api"
# 访问令牌的有效期（秒）——**滑动**：每次带令牌的请求都会往后延，
# 所以它是"闲置多久算掉线"，不是"登录后最多能用多久"；填 0 表示永不过期
token_ttl = 7200.0
# 长期令牌的有效期（秒）：勾了「记住设备」才发，用于下次自动登录；填 0 表示永不过期
remember_ttl = 2592000.0
# 是否逐条记访问日志（请求方法 / 路径 / 状态码 / 耗时）
access_log = true
# 是否信任 X-Forwarded-For 里的客户端 ip。默认 false：那个头客户端自己就能伪造，
# 只有确实挂在可信代理（nginx 等）后面才打开
trust_proxy = false
# 头像存放目录（个人设置的默认存储落这儿；相对路径按项目根目录解析）。
# 换成对象存储 / 落库时这一项就没用了 —— 落哪由那份实现自己交代
avatar_dir = "data/avatars"
# 单个头像的大小上限（字节）：超了回 413。默认 2 MiB
avatar_max_bytes = 2097152


# =============================================================================
# 区域 10/11：[onebot] —— OneBot 反向 WS 接入
# 框架当服务端，等 OneBot 实现（go-cqhttp / NapCat / LLOneBot …）连进来：
# 那边把「反向 WS」地址配成 ws://<host>:<port><path>
# =============================================================================
[onebot]
# WS 服务监听地址与端口（onebot.py 起的服务绑定在这里）。
# 默认 0.0.0.0 = 所有网卡都收，实现端在别的机器 / 容器里也连得进来；只让本机连改回 "127.0.0.1"
host = "0.0.0.0"
port = 16700
# 只接受该路径的连接（要 / 开头；OneBot 实现里配的反向 WS 地址要与之对应）
path = "/"
# 发一个动作后等回应的超时（秒），超时就当这次调用失败
action_timeout = 30.0


# =============================================================================
# 区域 11/11：[kook] —— Kook 正向 WS 接入
# 与 OneBot 相反：框架当客户端，主动连 Kook 网关。
# 网关地址在连接前自动获取；Bot Token **不在这个文件里** —— 它由接口层 /api/bots 添加机器人
# 时填、加密后落库，装配时解密逐个连。所以这一节没有「凭证」，只有连法调优与加密密钥。
# =============================================================================
[kook]
# 凭证加密密钥：留空则自动读/生成 data/secret_key（推荐留空）。
# 注意：换密钥等于换锁 —— 库里已存的 Bot Token 密文会解不开，那些机器人得重新添加
secret_key = ""
# 心跳间隔（秒）：Kook 网关要求定期发心跳，超时会被断开
heartbeat_interval = 30.0
# 心跳抖动（秒）：实际间隔在 间隔±抖动 里随机（官方口径 30 秒 + rand(-5, +5)）
heartbeat_jitter = 5.0
# 发一个动作（REST）后等回应的超时（秒）
action_timeout = 30.0
# 断线后重连的基准（秒）：官方流程是它 ×2^k —— 2、4（重连）-> 8、16（resume）
reconnect_interval = 2.0
# 重连退避上限（秒）：官方——回到「获取 Gateway」那一步后指数退避，最大间隔 60
reconnect_max_interval = 60.0
# 两次 REST 请求的最小间隔（秒）：限流，别一上来就撞 429
rest_min_interval = 0.2
# REST 瞬时失败重试次数（429 / 5xx / 网络抖动）
rest_max_retries = 3
# REST 持久连接的空闲上限（秒）：超了主动重建（服务端会按空闲时间掐连接，不重建就得白试一次）
rest_idle_timeout = 30.0
