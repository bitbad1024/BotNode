# =============================================================================
# nacho 应用配置模板
# =============================================================================
# 用法：复制成 config.toml 再按自己环境改（config.toml 已写进 .gitignore，不入库；
# 这个文件才是入库的模板，改它也改不了实际生效的配置）。
#     Windows:  copy config.toml.example config.toml
#     Linux:    cp   config.toml.example config.toml
#
# 怎么读这个文件：
#   1. 全文件按「区域」划分，一个区域 = 一节 = 一类设置，用横线隔开，跳着看即可：
#        [app]               进程名、调试开关
#        [database]          整项目共用的数据库连接（sqlite / mariadb）
#        [logging]           日志总控：级别、控制台
#        [logging.file]      日志落本地文件
#        [logging.database]  日志落数据库（连接项默认继承 [database]）
#        [logging.queue]     日志异步队列与分发器
#        [cache]             缓存总控：用哪个后端（默认本地内存）
#        [cache.redis]       Redis 连接（backend = "redis" 时才看）
#   2. 每项都在上一行写了自己管什么，值就是代码里的默认值 —— 不改就等于没写。
#   3. 整个文件不写、某一节不写、某一项不写都能跑，缺的按默认值补；
#      只有值写错（级别名拼错、该填整数填了字符串等）才会启动失败。
#   4. 顶层允许有别的节（留给 api / db 等层），不会被检查。
#
# 数据库配置按「专用 > 公共 > 默认」逐项覆盖：[logging.database] 的专用项 >
# [database] 公共项 > 代码里的字段默认值。
# =============================================================================


# =============================================================================
# 区域 1/9：[app] —— 进程自己
# =============================================================================
[app]
# 进程名，同时作为日志核心名（子实例都以它为前缀，如 nacho.app）
name = "nacho"
# 调试模式：置 true 时忽略 [logging] 的 level，直接把级别开到 DEBUG
debug = false


# =============================================================================
# 区域 2/9：[database] —— 数据库公共连接
# 整个项目共用的一份连接（日志出口、以后的数据层都默认用它）
# =============================================================================
[database]
# 用哪个后端：sqlite（本地单文件）/ mariadb（MariaDB / MySQL 服务）
driver = "sqlite"

# ---- 只有 driver = "sqlite" 时才看这几项 ----
# 数据库文件路径；相对路径相对项目根目录
path = "logs/nacho.db"

# ---- 只有 driver = "mariadb" 时才看这几项 ----
# 服务地址与端口
host = "127.0.0.1"
port = 3306
# 登录用户 / 密码（config.toml 不入库，密码写在这里不会进 git）
user = "nacho"
password = ""
# 库名（要事先建好：CREATE DATABASE nacho CHARACTER SET utf8mb4;）
database = "nacho"


# =============================================================================
# 区域 3/9：[logging] —— 日志总控
# =============================================================================
[logging]
# 最低输出级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
level = "INFO"
# 是否往控制台输出（服务端 / 无人值守时置 false）
console = true
# 控制台是否按级别上 ANSI 颜色
console_color = true
# 控制台单独的级别；留空 "" 表示跟随上面的 level（控制台通常只给人看，可以比文件粗）
console_level = ""


# =============================================================================
# 区域 4/9：[logging.file] —— 日志落本地文件
# =============================================================================
[logging.file]
# 是否落本地文件；false 就只有控制台
enabled = true
# 日志文件路径；相对路径相对项目根目录（app.py 所在目录）
path = "logs/nacho.log"
# 攒够多少条写一次盘（1 = 每条直写，最慢但最稳）
buffer_size = 200
# 最多攒多久（秒）必须写一次盘
flush_interval = 2.0
# 单个文件超过多少字节就切割（下面这个是 20MB）；0 表示不切割
max_bytes = 20971520
# 切割后保留几个历史文件
backup_count = 3


# =============================================================================
# 区域 5/9：[logging.database] —— 日志再落一份到数据库
# =============================================================================
[logging.database]
# 是否把日志再落一份到数据库（多一路出口，和文件出口并存）
enabled = false

# 日志出口特有的项（连接项默认整项继承上面的 [database]，只写日志特有的）
# 日志表名（启动时自动建表）
table = "logs"
# 攒够多少条写一次库
buffer_size = 500
# 最多攒多久（秒）必须写一次库
flush_interval = 5.0

# 要给日志单独连另一个库，就在这一节里按需覆盖，覆盖是逐项的（没写的继续继承）：
# driver = "mariadb"
# path = "logs/nacho-log.db"      # sqlite 用
# host = "10.0.0.5"               # mariadb 用
# port = 3306
# user = "nacho_log"
# password = ""
# database = "nacho_log"


# =============================================================================
# 区域 6/9：[logging.queue] —— 日志异步队列与分发器
# =============================================================================
[logging.queue]
# 队列容量，满了按「丢弃最旧」处理
maxsize = 10000
# 分发器一轮最多取多少条
dispatch_batch_size = 200
# 分发器一轮最多等多久（秒）
dispatch_timeout = 0.2


# =============================================================================
# 区域 7/9：[cache] —— 缓存总控
# 这一节不写也能用：默认走进程内存（本地缓存），不启用 Redis 也不用装它
# =============================================================================
[cache]
# 用哪个后端：memory（进程内存，默认）/ redis（Redis 服务，需 pip install "nacho[redis]"）
backend = "memory"
# Redis 上的键前缀；多个应用共用一个 Redis 实例时用它隔离（memory 后端不看这项）
namespace = "nacho"
# set() 没给 ttl 时用几秒过期；0 表示永不过期
default_ttl = 0.0
# Redis 连不上时是否退回本地缓存：true = 记一条 warning 继续跑，false = 启动阶段就报错
fallback_to_memory = true
# 本地缓存清扫过期键的间隔（秒）
sweep_interval = 30.0


# =============================================================================
# 区域 8/9：[cache.redis] —— Redis 连接
# 只有 backend = "redis" 时才看这一节
# =============================================================================
[cache.redis]
# 服务地址与端口
host = "127.0.0.1"
port = 6379
# 库号：不同库之间数据互相隔离（0-15）
db = 0
# Redis 6+ 的 ACL 用户名；留空 "" 表示默认用户
username = ""
# 密码（config.toml 不入库，密码写在这里不会进 git）；留空 "" 表示不认证
password = ""
# 单条命令的超时（秒）：连不上 / 卡住时按这个时间报错（或触发上面的降级）
socket_timeout = 5.0
# 连接池上限
max_connections = 10


# =============================================================================
# 区域 9/9：[api] —— 接口层（登录等对外接口）
# =============================================================================
[api]
# HTTP 服务监听地址与端口（接口层随主程序由 uvicorn 起）
host = "127.0.0.1"
port = 8000
# 路由前缀：登录接口最终挂在 <prefix>/auth/login
prefix = "/api"
# 登录令牌的有效期（秒）
token_ttl = 3600.0
# 是否逐条记访问日志（请求方法 / 路径 / 状态码 / 耗时）
access_log = true
# 令牌签名密钥；留空则进程启动时现生成一个随机的（重启后已签发的令牌全部失效）
secret = ""
