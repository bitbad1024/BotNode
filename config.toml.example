# nacho 应用配置模板
#
# 用法：复制成 config.toml 再按自己环境改（config.toml 已写进 .gitignore，不入库；
# 这个文件才是入库的模板，改它也改不了实际生效的配置）。
#     Windows:  copy config.toml.example config.toml
#     Linux:    cp   config.toml.example config.toml
#
# 用 # 写注释。整个文件不写、某一节不写、某一项不写都能跑，缺的按下面的默认值补；
# 只有值写错（级别名拼错、该填整数填了字符串等）才会启动失败。
# 顶层允许有别的节（留给 api / db 等层），不会被检查。

[app]
# 进程名，同时作为日志核心名（子实例都以它为前缀，如 nacho.app）
name = "nacho"
# 调试模式：置 true 时忽略 [logging] 的 level，直接把级别开到 DEBUG
debug = false

[logging]
# 最低输出级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
level = "INFO"
# 是否往控制台输出（服务端 / 无人值守时置 false）
console = true
# 控制台是否按级别上 ANSI 颜色
console_color = true
# 控制台单独的级别；留空 "" 表示跟随上面的 level（控制台通常只给人看，可以比文件粗）
console_level = ""

[logging.file]
# 是否落本地文件；false 就只有控制台
enabled = true
# 日志文件路径；相对路径相对项目根目录（app.py 所在目录）
path = "logs/nacho.log"
# 攒够多少条写一次盘（1 = 每条直写，最慢但最稳）
buffer_size = 200
# 最多攒多久（秒）必须写一次盘
flush_interval = 2.0
# 单个文件超过多少字节就切割（下面这个是 20MB）；0 表示不切割
max_bytes = 20971520
# 切割后保留几个历史文件
backup_count = 3

[logging.database]
# 是否把日志再落一份到数据库（多一路出口，和文件出口并存）
enabled = false
# 用哪个后端：sqlite（本地单文件）/ mariadb（MariaDB / MySQL 服务）
driver = "sqlite"

# ---- sqlite 才用（driver = "sqlite"）----
# 数据库文件路径；相对路径相对项目根目录
path = "logs/nacho.db"

# ---- mariadb 才用（driver = "mariadb"）----
# 服务地址与端口
host = "127.0.0.1"
port = 3306
# 登录用户 / 密码（config.toml 不入库，密码写在这里不会进 git）
user = "nacho"
password = ""
# 库名（要事先建好：CREATE DATABASE nacho CHARACTER SET utf8mb4;）
database = "nacho"

# ---- 两个后端共用 ----
# 日志表名（启动时自动建表）
table = "logs"
# 攒够多少条写一次库
buffer_size = 500
# 最多攒多久（秒）必须写一次库
flush_interval = 5.0

[logging.queue]
# 队列容量，满了按「丢弃最旧」处理
maxsize = 10000
# 分发器一轮最多取多少条
dispatch_batch_size = 200
# 分发器一轮最多等多久（秒）
dispatch_timeout = 0.2
